<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nova.factoryerp.controllers.inventory.CustomerHistoryController"
            stylesheets="@../../css/nova-erp.css"
            style="-fx-background-color:#11151f;">

    <!-- =========================================================
         TOP
         ========================================================= -->

    <top>

        <VBox spacing="4"
              style="-fx-padding:24 28 20 28;">

            <HBox spacing="8"
                  alignment="CENTER_LEFT">

                <Label text="Customer History"
                       style="-fx-font-size:24px;
                              -fx-font-weight:bold;
                              -fx-text-fill:#ffffff;"/>

            </HBox>

            <HBox spacing="6"
                  alignment="CENTER_LEFT">

                <Label fx:id="customerNameLabel"
                       text="-"
                       style="-fx-font-size:14px;
                              -fx-font-weight:bold;
                              -fx-text-fill:#4e8ef7;"/>

                <Label fx:id="customerCodeLabel"
                       text="[-]"
                       style="-fx-font-size:13px;
                              -fx-text-fill:#9199b0;"/>

            </HBox>

        </VBox>

    </top>


    <!-- =========================================================
         CENTER
         ========================================================= -->

    <center>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background-color:transparent;
                           -fx-background:transparent;">

            <VBox spacing="18"
                  style="-fx-padding:0 28 28 28;">

                <!-- =============================================
                     SUMMARY
                     ============================================= -->

                <GridPane hgap="12"
                          vgap="12">

                    <columnConstraints>

                        <ColumnConstraints
                                percentWidth="33.33"
                                hgrow="ALWAYS"/>

                        <ColumnConstraints
                                percentWidth="33.33"
                                hgrow="ALWAYS"/>

                        <ColumnConstraints
                                percentWidth="33.33"
                                hgrow="ALWAYS"/>

                    </columnConstraints>


                    <!-- Total Orders -->

                    <VBox spacing="4"
                          style="-fx-background-color:#1a1e2a;
                                 -fx-background-radius:8;
                                 -fx-padding:15;">

                        <Label text="Total Orders"
                               style="-fx-text-fill:#9199b0;
                                      -fx-font-size:12px;"/>

                        <Label fx:id="totalOrdersLabel"
                               text="0"
                               style="-fx-text-fill:#ffffff;
                                      -fx-font-size:20px;
                                      -fx-font-weight:bold;"/>

                    </VBox>


                    <!-- Completed Orders -->

                    <VBox spacing="4"
                          GridPane.columnIndex="1"
                          style="-fx-background-color:#1a1e2a;
                                 -fx-background-radius:8;
                                 -fx-padding:15;">

                        <Label text="Completed Orders"
                               style="-fx-text-fill:#9199b0;
                                      -fx-font-size:12px;"/>

                        <Label fx:id="completedOrdersLabel"
                               text="0"
                               style="-fx-text-fill:#6ee7a5;
                                      -fx-font-size:20px;
                                      -fx-font-weight:bold;"/>

                    </VBox>


                    <!-- Boxes -->

                    <VBox spacing="4"
                          GridPane.columnIndex="2"
                          style="-fx-background-color:#1a1e2a;
                                 -fx-background-radius:8;
                                 -fx-padding:15;">

                        <Label text="Total Boxes Purchased"
                               style="-fx-text-fill:#9199b0;
                                      -fx-font-size:12px;"/>

                        <Label fx:id="totalBoxesLabel"
                               text="0"
                               style="-fx-text-fill:#ffffff;
                                      -fx-font-size:20px;
                                      -fx-font-weight:bold;"/>

                    </VBox>


                    <!-- Total Amount -->

                    <VBox spacing="4"
                          GridPane.rowIndex="1"
                          style="-fx-background-color:#1a1e2a;
                                 -fx-background-radius:8;
                                 -fx-padding:15;">

                        <Label text="Total Amount"
                               style="-fx-text-fill:#9199b0;
                                      -fx-font-size:12px;"/>

                        <Label fx:id="totalAmountLabel"
                               text="Rs. 0.00"
                               style="-fx-text-fill:#ffffff;
                                      -fx-font-size:18px;
                                      -fx-font-weight:bold;"/>

                    </VBox>


                    <!-- Total Paid -->

                    <VBox spacing="4"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"
                          style="-fx-background-color:#1a1e2a;
                                 -fx-background-radius:8;
                                 -fx-padding:15;">

                        <Label text="Total Paid"
                               style="-fx-text-fill:#9199b0;
                                      -fx-font-size:12px;"/>

                        <Label fx:id="totalPaidLabel"
                               text="Rs. 0.00"
                               style="-fx-text-fill:#6ee7a5;
                                      -fx-font-size:18px;
                                      -fx-font-weight:bold;"/>

                    </VBox>


                    <!-- Outstanding -->

                    <VBox spacing="4"
                          GridPane.columnIndex="2"
                          GridPane.rowIndex="1"
                          style="-fx-background-color:#1a1e2a;
                                 -fx-background-radius:8;
                                 -fx-padding:15;">

                        <Label text="Outstanding"
                               style="-fx-text-fill:#9199b0;
                                      -fx-font-size:12px;"/>

                        <Label fx:id="outstandingLabel"
                               text="Rs. 0.00"
                               style="-fx-text-fill:#ffb86b;
                                      -fx-font-size:18px;
                                      -fx-font-weight:bold;"/>

                    </VBox>

                </GridPane>


                <!-- =============================================
                     ORDER HISTORY TITLE
                     ============================================= -->

                <Label text="Order History"
                       style="-fx-font-size:17px;
                              -fx-font-weight:bold;
                              -fx-text-fill:#ffffff;"/>


                <!-- =============================================
                     ORDERS
                     ============================================= -->

                <VBox fx:id="ordersContainer"
                      spacing="14"/>

            </VBox>

        </ScrollPane>

    </center>


    <!-- =========================================================
         BOTTOM
         ========================================================= -->

    <bottom>

        <HBox alignment="CENTER_RIGHT"
              style="-fx-padding:14 28 18 28;">

            <Button text="Close"
                    onAction="#handleClose"
                    styleClass="btn-secondary"
                    style="-fx-padding:7 18 7 18;"/>

        </HBox>

    </bottom>

</BorderPane>